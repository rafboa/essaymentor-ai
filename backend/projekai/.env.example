# Database Connection
DATABASE_URL="mysql://username:password@localhost:3306/projekai"

# Google Gemini API Key (Primary Engine)
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key (Fallback Engine)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Deepseek API Key (Optional)
DEEPSEEK_API_KEY=""

# Application Port
PORT=3000

# Security & Authentication
# WAJIB diisi rahasia unik dan acak di production (min 32 karakter)
JWT_SECRET="replace_with_a_secure_random_jwt_secret"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3001"

# Environment Mode
NODE_ENV="development"
